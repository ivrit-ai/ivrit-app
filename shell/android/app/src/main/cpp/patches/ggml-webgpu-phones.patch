@@ -0,0 +1,193 @@
+enable f16;
+
+// q8_0 (or f16, SRC0_F16) x f32 matrix multiply for phone GPUs, without subgroups: a 64 x 64 tile of
+// the output per workgroup of 64 threads, 8 x 8 outputs per thread. Both tiles sit in
+// shared memory as vec4<f16> along M (src0) and N (src1), k by k, so each step reads
+// four vectors and does sixteen vec4 multiply-adds in f32.
+
+struct MulMatParams {
+    offset_src0: u32,
+    offset_src1: u32,
+    offset_dst: u32,
+    m: u32,
+    n: u32,
+    k: u32,
+    stride_01: u32,
+    stride_11: u32,
+    stride_02: u32,
+    stride_12: u32,
+    stride_03: u32,
+    stride_13: u32,
+    bs02: u32,
+    bs03: u32,
+    broadcast2: u32,
+    broadcast3: u32
+};
+
+#ifdef SRC0_F16
+@group(0) @binding(0) var<storage, read_write> src0: array<f16>; // M rows of K
+#else
+@group(0) @binding(0) var<storage, read_write> src0: array<u32>; // q8_0 blocks (34 bytes), M rows of K
+#endif
+@group(0) @binding(1) var<storage, read_write> src1: array<f32>; // N columns of K
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;  // N columns of M
+@group(0) @binding(3) var<uniform> params: MulMatParams;
+
+const WG_M = 8u;
+const BM = 64u;
+const BN = 64u;
+const BK = 32u;    // one q8_0 block
+const BM4 = 16u;   // BM / 4
+const BN4 = 16u;
+
+var<workgroup> sa: array<vec4<f16>, 512>; // [k][m / 4]
+var<workgroup> sb: array<vec4<f16>, 512>; // [k][n / 4]
+
+#ifndef SRC0_F16
+fn load_u32_src0(byte_offset: u32) -> u32 {
+    let word = byte_offset / 4u;
+    let shift = (byte_offset & 3u) * 8u;
+    let lo = src0[word];
+    let hi = src0[word + 1u];
+    return select((lo >> shift) | (hi << (32u - shift)), lo, shift == 0u);
+}
+
+fn i8_at(w: u32, i: u32) -> f32 {
+    return f32(bitcast<i32>(w << (24u - 8u * i)) >> 24u);
+}
+
+// 8 weights of row `m` from k0 on (within its block), scaled; zeros past the matrix.
+fn row8(base: u32, m: u32, kb: u32, k0: u32) -> array<f32, 8> {
+    var v: array<f32, 8>;
+    if (m < params.m) {
+        let b = (base + m * params.stride_01 + kb) * 34u;
+        let d = unpack2x16float(load_u32_src0(b) & 0xFFFFu).x;
+        let w0 = load_u32_src0(b + 2u + k0);
+        let w1 = load_u32_src0(b + 6u + k0);
+        for (var i = 0u; i < 4u; i++) {
+            v[i] = i8_at(w0, i) * d;
+            v[i + 4u] = i8_at(w1, i) * d;
+        }
+    }
+    return v;
+}
+#else
+// 8 values of row `m` from k on; zeros past the matrix (never read: no bounds checks here).
+fn row8(base: u32, m: u32, kb: u32, k: u32) -> array<f32, 8> {
+    var v: array<f32, 8>;
+    if (m < params.m) {
+        let at = base + m * params.stride_01 + kb * BK + k;
+        for (var i = 0u; i < 8u; i++) {
+            if (kb * BK + k + i < params.k) {
+                v[i] = f32(src0[at + i]);
+            }
+        }
+    }
+    return v;
+}
+#endif
+
+fn col8(base: u32, n: u32, k: u32) -> array<f32, 8> {
+    var v: array<f32, 8>;
+    if (n < params.n) {
+        let at = base + n * params.stride_11 + k;
+        for (var i = 0u; i < 8u; i++) {
+            if (k + i < params.k) {
+                v[i] = src1[at + i];
+            }
+        }
+    }
+    return v;
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(workgroup_id) wg_id: vec3<u32>,
+        @builtin(local_invocation_id) local_id: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let t = local_id.x;
+
+    let wg_m_count = (params.m + BM - 1u) / BM;
+    let wg_n_count = (params.n + BN - 1u) / BN;
+    let wg_per_matrix = wg_m_count * wg_n_count;
+    let wg_linear = wg_id.y * num_wg.x + wg_id.x;
+    let batch_idx = wg_linear / wg_per_matrix;
+    let total_batches = params.bs02 * params.broadcast2 * params.bs03 * params.broadcast3;
+    if (batch_idx >= total_batches) {
+        return;
+    }
+    let wg_in_batch = wg_linear % wg_per_matrix;
+    let offset_m = (wg_in_batch % wg_m_count) * BM;
+    let offset_n = (wg_in_batch / wg_m_count) * BN;
+
+    let dst3_idx = batch_idx / (params.bs02 * params.broadcast2);
+    let dst2_idx = batch_idx % (params.bs02 * params.broadcast2);
+    let src0_base = params.offset_src0 + (dst3_idx / params.broadcast3) * params.stride_03 + (dst2_idx / params.broadcast2) * params.stride_02;
+    let src1_base = params.offset_src1 + dst3_idx * params.stride_13 + dst2_idx * params.stride_12;
+
+    // Loading: thread t fills four rows (columns) 4g..4g+3 at k 8h..8h+7.
+    let g = t % 16u;
+    let h = t / 16u;
+    // Computing: thread t's 8 x 8 outputs.
+    let lm = t % WG_M;
+    let ln = t / WG_M;
+
+    var acc: array<vec4<f32>, 16>; // [n][m half]
+
+    for (var k_outer = 0u; k_outer < params.k; k_outer += BK) {
+        let kb = k_outer / BK;
+        let r0 = row8(src0_base, offset_m + 4u * g, kb, 8u * h);
+        let r1 = row8(src0_base, offset_m + 4u * g + 1u, kb, 8u * h);
+        let r2 = row8(src0_base, offset_m + 4u * g + 2u, kb, 8u * h);
+        let r3 = row8(src0_base, offset_m + 4u * g + 3u, kb, 8u * h);
+        let c0 = col8(src1_base, offset_n + 4u * g, k_outer + 8u * h);
+        let c1 = col8(src1_base, offset_n + 4u * g + 1u, k_outer + 8u * h);
+        let c2 = col8(src1_base, offset_n + 4u * g + 2u, k_outer + 8u * h);
+        let c3 = col8(src1_base, offset_n + 4u * g + 3u, k_outer + 8u * h);
+        for (var i = 0u; i < 8u; i++) {
+            sa[(8u * h + i) * BM4 + g] = vec4<f16>(vec4<f32>(r0[i], r1[i], r2[i], r3[i]));
+            sb[(8u * h + i) * BN4 + g] = vec4<f16>(vec4<f32>(c0[i], c1[i], c2[i], c3[i]));
+        }
+        workgroupBarrier();
+
+        for (var k = 0u; k < BK; k++) {
+            let a0 = vec4<f32>(sa[k * BM4 + 2u * lm]);
+            let a1 = vec4<f32>(sa[k * BM4 + 2u * lm + 1u]);
+            let b0 = vec4<f32>(sb[k * BN4 + 2u * ln]);
+            let b1 = vec4<f32>(sb[k * BN4 + 2u * ln + 1u]);
+            acc[0] = fma(a0, vec4<f32>(b0.x), acc[0]);
+            acc[1] = fma(a1, vec4<f32>(b0.x), acc[1]);
+            acc[2] = fma(a0, vec4<f32>(b0.y), acc[2]);
+            acc[3] = fma(a1, vec4<f32>(b0.y), acc[3]);
+            acc[4] = fma(a0, vec4<f32>(b0.z), acc[4]);
+            acc[5] = fma(a1, vec4<f32>(b0.z), acc[5]);
+            acc[6] = fma(a0, vec4<f32>(b0.w), acc[6]);
+            acc[7] = fma(a1, vec4<f32>(b0.w), acc[7]);
+            acc[8] = fma(a0, vec4<f32>(b1.x), acc[8]);
+            acc[9] = fma(a1, vec4<f32>(b1.x), acc[9]);
+            acc[10] = fma(a0, vec4<f32>(b1.y), acc[10]);
+            acc[11] = fma(a1, vec4<f32>(b1.y), acc[11]);
+            acc[12] = fma(a0, vec4<f32>(b1.z), acc[12]);
+            acc[13] = fma(a1, vec4<f32>(b1.z), acc[13]);
+            acc[14] = fma(a0, vec4<f32>(b1.w), acc[14]);
+            acc[15] = fma(a1, vec4<f32>(b1.w), acc[15]);
+        }
+        workgroupBarrier();
+    }
+
+    let dst_base = params.offset_dst + dst3_idx * (params.m * params.n * params.bs02 * params.broadcast2) + dst2_idx * (params.m * params.n);
+    let m0 = offset_m + 8u * lm;
+    for (var j = 0u; j < 8u; j++) {
+        let n = offset_n + 8u * ln + j;
+        if (n < params.n) {
+            let at = dst_base + n * params.m + m0;
+            for (var i = 0u; i < 4u; i++) {
+                if (m0 + i < params.m) {
+                    dst[at + i] = acc[2u * j][i];
+                }
+                if (m0 + 4u + i < params.m) {
+                    dst[at + 4u + i] = acc[2u * j + 1u][i];
+                }
+            }
+        }
+    }
+}

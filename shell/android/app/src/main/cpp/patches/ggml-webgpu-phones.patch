+++ b/ggml/src/ggml-webgpu/wgsl-shaders/flash_attn_mobile.wgsl
@@ -0,0 +1,145 @@
+enable f16;
+
+// Flash attention for phone GPUs, without subgroups: f32 Q, f16 K and V, head size
+// 64, no mask or sinks (Whisper's encoder). One query row per thread, 64 rows per
+// workgroup; keys and values 16 at a time in shared memory, their scores first, then
+// one rescale of the running output per 16 keys (online softmax).
+
+struct Params {
+    offset_q: u32,
+    offset_k: u32,
+    offset_v: u32,
+    offset_mask: u32,
+    offset_sinks: u32,
+    offset_dst: u32,
+    n_heads: u32,
+    seq_len_q: u32,
+    seq_len_kv: u32,
+    stride_q1: u32,
+    stride_q2: u32,
+    stride_q3: u32,
+    stride_k1: u32,
+    stride_k2: u32,
+    stride_k3: u32,
+    stride_v1: u32,
+    stride_v2: u32,
+    stride_v3: u32,
+    stride_mask3: u32,
+    q_per_kv: u32,
+    scale: f32,
+    max_bias: f32,
+    logit_softcap: f32,
+    n_head_log2: f32,
+    m0: f32,
+    m1: f32,
+};
+
+@group(0) @binding(0) var<storage, read_write> Q: array<f32>;
+#ifdef KV_OVERLAP
+@group(0) @binding(1) var<storage, read_write> KV: array<f16>;
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(3) var<uniform> params: Params;
+#define K KV
+#define V KV
+#else
+@group(0) @binding(1) var<storage, read_write> K: array<f16>;
+@group(0) @binding(2) var<storage, read_write> V: array<f16>;
+@group(0) @binding(3) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(4) var<uniform> params: Params;
+#endif
+
+const D = 64u;
+const D4 = 16u;
+const QT = 64u;  // query rows per workgroup, one per thread
+const KT = 8u;   // keys per step
+const NEG = -1.0e30;
+
+var<workgroup> ks: array<vec4<f16>, 128>; // [key][d / 4]
+var<workgroup> vs: array<vec4<f16>, 128>;
+
+@compute @workgroup_size(64)
+fn main(@builtin(workgroup_id) wg_id: vec3<u32>,
+        @builtin(local_invocation_id) local_id: vec3<u32>) {
+    let t = local_id.x;
+    let wg_per_head = (params.seq_len_q + QT - 1u) / QT;
+    let wg_per_batch = wg_per_head * params.n_heads;
+    let batch = wg_id.x / wg_per_batch;
+    let in_batch = wg_id.x % wg_per_batch;
+    let head = in_batch / wg_per_head;
+    let q_row = (in_batch % wg_per_head) * QT + t;
+    let live = q_row < params.seq_len_q;
+    let kv_head = head / params.q_per_kv;
+
+    let k_base = params.offset_k + batch * params.stride_k3 + kv_head * params.stride_k2;
+    let v_base = params.offset_v + batch * params.stride_v3 + kv_head * params.stride_v2;
+
+    var q: array<vec4<f16>, 16>; // f16 to keep registers down; the math is f32
+    if (live) {
+        let at = params.offset_q + batch * params.stride_q3 + head * params.stride_q2 + q_row * params.stride_q1;
+        for (var d4 = 0u; d4 < D4; d4++) {
+            let i = at + 4u * d4;
+            q[d4] = vec4<f16>(vec4<f32>(Q[i], Q[i + 1u], Q[i + 2u], Q[i + 3u]) * params.scale);
+        }
+    }
+
+    var o: array<vec4<f32>, 16>;
+    var m = NEG;
+    var l = 0.0;
+
+    for (var kv0 = 0u; kv0 < params.seq_len_kv; kv0 += KT) {
+        for (var i = 0u; i < 2u; i++) {
+            let idx = t + 64u * i;
+            let key = kv0 + idx / D4;
+            let d = 4u * (idx % D4);
+            var kv = vec4<f16>(0.0);
+            var vv = vec4<f16>(0.0);
+            if (key < params.seq_len_kv) {
+                let ka = k_base + key * params.stride_k1 + d;
+                let va = v_base + key * params.stride_v1 + d;
+                kv = vec4<f16>(K[ka], K[ka + 1u], K[ka + 2u], K[ka + 3u]);
+                vv = vec4<f16>(V[va], V[va + 1u], V[va + 2u], V[va + 3u]);
+            }
+            ks[idx] = kv;
+            vs[idx] = vv;
+        }
+        workgroupBarrier();
+
+        var s: array<f32, 8>;
+        var tile_max = NEG;
+        for (var j = 0u; j < KT; j++) {
+            var acc = 0.0;
+            for (var d4 = 0u; d4 < D4; d4++) {
+                acc += dot(vec4<f32>(q[d4]), vec4<f32>(ks[j * D4 + d4]));
+            }
+            s[j] = select(NEG, acc, kv0 + j < params.seq_len_kv);
+            tile_max = max(tile_max, s[j]);
+        }
+        let m_new = max(m, tile_max);
+        let corr = exp(m - m_new);
+        l *= corr;
+        for (var d4 = 0u; d4 < D4; d4++) {
+            o[d4] *= corr;
+        }
+        for (var j = 0u; j < KT; j++) {
+            let p = exp(s[j] - m_new);
+            l += p;
+            for (var d4 = 0u; d4 < D4; d4++) {
+                o[d4] = fma(vec4<f32>(p), vec4<f32>(vs[j * D4 + d4]), o[d4]);
+            }
+        }
+        m = m_new;
+        workgroupBarrier();
+    }
+
+    if (live) {
+        let inv = select(0.0, 1.0 / l, l > 0.0);
+        let at = params.offset_dst + batch * (D * params.n_heads * params.seq_len_q) + q_row * (D * params.n_heads) + head * D;
+        for (var d4 = 0u; d4 < D4; d4++) {
+            let v = o[d4] * inv;
+            dst[at + 4u * d4] = v.x;
+            dst[at + 4u * d4 + 1u] = v.y;
+            dst[at + 4u * d4 + 2u] = v.z;
+            dst[at + 4u * d4 + 3u] = v.w;
+        }
+    }
+}

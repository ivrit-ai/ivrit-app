+// Flash attention for phone GPUs, without subgroups: f32 Q, f16 K and V, head size
+// 64, no mask or sinks (Whisper's encoder). One query row per thread, 64 rows per
+// workgroup; keys and values 8 at a time in shared memory, their scores first, then
+// one rescale of the running output per 8 keys (online softmax). The query is held
+// in f16 (in f32, registers spilled: twelve times slower). Every loop over the head's
+// 16 vectors and the 8 keys is written out (by a script), so no private array is
+// indexed by a loop: some compilers (Intel's, through Direct3D 12) keep such arrays
+// in memory.
+
+struct Params {
+    offset_q: u32,
+    offset_k: u32,
+    offset_v: u32,
+    offset_mask: u32,
+    offset_sinks: u32,
+    offset_dst: u32,
+    n_heads: u32,
+    seq_len_q: u32,
+    seq_len_kv: u32,
+    stride_q1: u32,

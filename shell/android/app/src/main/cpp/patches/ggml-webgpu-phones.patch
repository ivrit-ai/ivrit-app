 /** WebGPU Actions */
 
+// A lost device, a device error, a wait that failed or timed out: thrown (std::runtime_error) at the
+// next wait, on the caller's thread, so an app can take it and go on without the GPU, rather than the
+// process ending. Dawn's callbacks only note it, as they may run on its own threads.
+static std::mutex  ggml_webgpu_failure_mutex;
+static std::string ggml_webgpu_failure;
+
+static void ggml_webgpu_note_failure(const std::string & what) {
+    std::lock_guard<std::mutex> lock(ggml_webgpu_failure_mutex);
+    if (ggml_webgpu_failure.empty()) {
+        ggml_webgpu_failure = what;
+    }
+}
+
+[[noreturn]] static void ggml_webgpu_fail(const std::string & what) {
+    std::string noted;
+    {
+        std::lock_guard<std::mutex> lock(ggml_webgpu_failure_mutex);
+        noted = ggml_webgpu_failure;
+    }
+    GGML_LOG_ERROR("ggml_webgpu: %s%s%s\n", what.c_str(), noted.empty() ? "" : ": ", noted.c_str());
+    throw std::runtime_error("ggml_webgpu: " + what + (noted.empty() ? "" : ": " + noted));
+}

+    let src1_base = params.offset_src1 + dst3_idx * params.stride_13 + dst2_idx * params.stride_12;
+
+    // Computing: thread t's 8 (or 4) rows by 8 (or 4) columns.
+    let lm = t % WG_M;
+    let ln = t / WG_M;
+    let kk = t % BK;
+
+    // c{column}{rows 0-3: a, 4-7: b}
+    var c0a = vec4<f32>(0.0); var c0b = vec4<f32>(0.0);
+    var c1a = vec4<f32>(0.0); var c1b = vec4<f32>(0.0);
+    var c2a = vec4<f32>(0.0); var c2b = vec4<f32>(0.0);
+    var c3a = vec4<f32>(0.0); var c3b = vec4<f32>(0.0);
+#ifndef TN4
+    var c4a = vec4<f32>(0.0); var c4b = vec4<f32>(0.0);
+    var c5a = vec4<f32>(0.0); var c5b = vec4<f32>(0.0);
+    var c6a = vec4<f32>(0.0); var c6b = vec4<f32>(0.0);
+    var c7a = vec4<f32>(0.0); var c7b = vec4<f32>(0.0);
+#endif
+
+    for (var k_outer = 0u; k_outer < params.k; k_outer += BK) {
+        let kb = k_outer / BK;
+#ifdef TM4
+        if (t < BM) { load_row(src0_base, offset_m + t, t, kb); }
+#else
+        load_row(src0_base, offset_m + t, t, kb);
+#endif
+        // BN / 4 groups of four columns at BK k: two runs of 32 threads take turns.
+        for (var group = t / BK; group < BN4; group += 2u) {
+            load_cols(src1_base, offset_n + 4u * group, k_outer + kk, group, kk);
+        }
+        workgroupBarrier();
+
+#ifdef HALF
+        var p0a = vec4<f16>(0.0h); var p0b = vec4<f16>(0.0h);
+        var p1a = vec4<f16>(0.0h); var p1b = vec4<f16>(0.0h);
+        var p2a = vec4<f16>(0.0h); var p2b = vec4<f16>(0.0h);
+        var p3a = vec4<f16>(0.0h); var p3b = vec4<f16>(0.0h);
+        for (var k = 0u; k < BK; k++) {
+            let a0 = sa[k * BM4 + 2u * lm];
+            let a1 = sa[k * BM4 + 2u * lm + 1u];
+            let b0 = sb[k * BN4 + ln];
+            p0a = fma(a0, vec4<f16>(b0.x), p0a); p0b = fma(a1, vec4<f16>(b0.x), p0b);
+            p1a = fma(a0, vec4<f16>(b0.y), p1a); p1b = fma(a1, vec4<f16>(b0.y), p1b);
+            p2a = fma(a0, vec4<f16>(b0.z), p2a); p2b = fma(a1, vec4<f16>(b0.z), p2b);
+            p3a = fma(a0, vec4<f16>(b0.w), p3a); p3b = fma(a1, vec4<f16>(b0.w), p3b);
+        }
+        c0a += vec4<f32>(p0a); c0b += vec4<f32>(p0b);
+        c1a += vec4<f32>(p1a); c1b += vec4<f32>(p1b);
+        c2a += vec4<f32>(p2a); c2b += vec4<f32>(p2b);
+        c3a += vec4<f32>(p3a); c3b += vec4<f32>(p3b);
+#else
+        for (var k = 0u; k < BK; k++) {
+#ifdef TM4
+            let a0 = vec4<f32>(sa[k * BM4 + lm]);
+#else
+            let a0 = vec4<f32>(sa[k * BM4 + 2u * lm]);
+            let a1 = vec4<f32>(sa[k * BM4 + 2u * lm + 1u]);
+#endif
+#ifdef TN4
+            let b0 = vec4<f32>(sb[k * BN4 + ln]);
+#else
+            let b0 = vec4<f32>(sb[k * BN4 + 2u * ln]);
+            let b1 = vec4<f32>(sb[k * BN4 + 2u * ln + 1u]);
+#endif
+#ifdef TM4
+            c0a = fma(a0, vec4<f32>(b0.x), c0a);
+            c1a = fma(a0, vec4<f32>(b0.y), c1a);
+            c2a = fma(a0, vec4<f32>(b0.z), c2a);
+            c3a = fma(a0, vec4<f32>(b0.w), c3a);
+#else
+            c0a = fma(a0, vec4<f32>(b0.x), c0a); c0b = fma(a1, vec4<f32>(b0.x), c0b);
+            c1a = fma(a0, vec4<f32>(b0.y), c1a); c1b = fma(a1, vec4<f32>(b0.y), c1b);
+            c2a = fma(a0, vec4<f32>(b0.z), c2a); c2b = fma(a1, vec4<f32>(b0.z), c2b);
+            c3a = fma(a0, vec4<f32>(b0.w), c3a); c3b = fma(a1, vec4<f32>(b0.w), c3b);
+#endif
+#ifndef TN4
+            c4a = fma(a0, vec4<f32>(b1.x), c4a); c4b = fma(a1, vec4<f32>(b1.x), c4b);
+            c5a = fma(a0, vec4<f32>(b1.y), c5a); c5b = fma(a1, vec4<f32>(b1.y), c5b);
+            c6a = fma(a0, vec4<f32>(b1.z), c6a); c6b = fma(a1, vec4<f32>(b1.z), c6b);
+            c7a = fma(a0, vec4<f32>(b1.w), c7a); c7b = fma(a1, vec4<f32>(b1.w), c7b);
+#endif
+        }
+#endif
+        workgroupBarrier();
+    }
+
+    let dst_base = params.offset_dst + dst3_idx * (params.m * params.n * params.bs02 * params.broadcast2) + dst2_idx * (params.m * params.n);
+#ifdef TM4
+    let m0 = offset_m + 4u * lm;
+    let n0 = offset_n + 4u * ln;
+    if (n0 < params.n) { store4(dst_base + n0 * params.m + m0, m0, c0a); }
+    if (n0 + 1u < params.n) { store4(dst_base + (n0 + 1u) * params.m + m0, m0, c1a); }
+    if (n0 + 2u < params.n) { store4(dst_base + (n0 + 2u) * params.m + m0, m0, c2a); }
+    if (n0 + 3u < params.n) { store4(dst_base + (n0 + 3u) * params.m + m0, m0, c3a); }
+#else
+    let m0 = offset_m + 8u * lm;
+#ifdef TN4
+    let n0 = offset_n + 4u * ln;
+#else
+    let n0 = offset_n + 8u * ln;
+#endif
+    if (n0 < params.n) { store8(dst_base + n0 * params.m + m0, m0, c0a, c0b); }
+    if (n0 + 1u < params.n) { store8(dst_base + (n0 + 1u) * params.m + m0, m0, c1a, c1b); }
+    if (n0 + 2u < params.n) { store8(dst_base + (n0 + 2u) * params.m + m0, m0, c2a, c2b); }
+    if (n0 + 3u < params.n) { store8(dst_base + (n0 + 3u) * params.m + m0, m0, c3a, c3b); }
+#ifndef TN4
+    if (n0 + 4u < params.n) { store8(dst_base + (n0 + 4u) * params.m + m0, m0, c4a, c4b); }
+    if (n0 + 5u < params.n) { store8(dst_base + (n0 + 5u) * params.m + m0, m0, c5a, c5b); }
+    if (n0 + 6u < params.n) { store8(dst_base + (n0 + 6u) * params.m + m0, m0, c6a, c6b); }
+    if (n0 + 7u < params.n) { store8(dst_base + (n0 + 7u) * params.m + m0, m0, c7a, c7b); }
+#endif
+#endif
+}
--- a/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_vec_mobile.wgsl
+++ b/ggml/src/ggml-webgpu/wgsl-shaders/mul_mat_vec_mobile.wgsl
@@ -0,0 +1,310 @@
+enable f16;
+
+// q8_0 (or q4_0, SRC0_Q4_0; or f16, SRC0_F16) x f32 matrix-vector multiply for phone and laptop GPUs,
+// without subgroups, for up to 8 columns (a decoder step: beam search's 5). Four
+// neighbouring threads a row, 64 rows a workgroup (each tile of the columns' values
+// serves that many rows' weights): each takes every fourth q8_0
+// block of the row, so neighbouring threads read neighbouring memory (a step is
+// reading all the weights once); the columns' values, 256 at a time, sit in shared
+// memory, read by all threads at the same address; the four threads' sums are added
+// in shared memory at the end. The 8 columns' sums are written out (no private array
+// indexed by a loop), each but the first behind its own switch (C1..C7: the step's
+// columns, as compiled), so 1 column costs 1. Written by a script.
+
+struct MulMatParams {
+    offset_src0: u32,
+    offset_src1: u32,
+    offset_dst: u32,
+    m: u32,
+    n: u32,
+    k: u32,
+    stride_01: u32,
+    stride_11: u32,
+    stride_02: u32,
+    stride_12: u32,
+    stride_03: u32,
+    stride_13: u32,
+    bs02: u32,
+    bs03: u32,
+    broadcast2: u32,
+    broadcast3: u32
+};
+
+#ifdef SRC0_F16
+@group(0) @binding(0) var<storage, read_write> src0: array<f16>;
+#else
+@group(0) @binding(0) var<storage, read_write> src0: array<u32>;
+#endif
+@group(0) @binding(1) var<storage, read_write> src1: array<f32>;
+@group(0) @binding(2) var<storage, read_write> dst: array<f32>;
+@group(0) @binding(3) var<uniform> params: MulMatParams;
+
+const TK = 256u;         // k a tile
+const TK4 = TK / 4u;
+const COLS = 8u;
+const LANES = 4u;        // threads a row
+const ROWS = 64u;        // rows a workgroup
+const THREADS = 256u;
+
+var<workgroup> sx: array<vec4<f32>, COLS * TK4>; // [column][k / 4]
+var<workgroup> partial: array<f32, 256 * 8>;     // [thread][column]
+
+#ifndef SRC0_F16
+fn load_u32_src0(byte_offset: u32) -> u32 {
+    let word = byte_offset / 4u;
+    let shift = (byte_offset & 3u) * 8u;
+    let lo = src0[word];
+    let hi = src0[word + 1u];
+    return select((lo >> shift) | (hi << (32u - shift)), lo, shift == 0u);
+}
+
+fn i8x4(w: u32) -> vec4<f32> {
+    return vec4<f32>(f32(bitcast<i32>(w << 24u) >> 24u), f32(bitcast<i32>(w << 16u) >> 24u),
+                     f32(bitcast<i32>(w << 8u) >> 24u), f32(bitcast<i32>(w) >> 24u));
+}
+
+#ifdef SRC0_Q4_0
+const BLOCK_BYTES = 18u;
+
+// Weights 4i..4i+3 of the q4_0 block at byte b (i < 8): its 16 bytes' low halves are
+// weights 0-15, their high halves 16-31, each less 8.
+fn block_weights(b: u32, i: u32) -> vec4<f32> {
+    let w = load_u32_src0(b + 2u + 4u * (i % 4u)) >> (4u * (i / 4u));
+    return vec4<f32>(f32(w & 0xFu), f32((w >> 8u) & 0xFu), f32((w >> 16u) & 0xFu), f32((w >> 24u) & 0xFu)) - 8.0;
+}
+#else
+const BLOCK_BYTES = 34u;
+
+// Weights 4i..4i+3 of the q8_0 block at byte b (i < 8).
+fn block_weights(b: u32, i: u32) -> vec4<f32> {
+    return i8x4(load_u32_src0(b + 2u + 4u * i));
+}
+#endif
+#endif
+
+@compute @workgroup_size(256)
+fn main(@builtin(workgroup_id) wg_id: vec3<u32>,
+        @builtin(local_invocation_id) local_id: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>) {
+    let t = local_id.x;
+    let lane = t % LANES;
+    let wg_per_matrix = (params.m + ROWS - 1u) / ROWS;
+    let wg_linear = wg_id.y * num_wg.x + wg_id.x;
+    let batch_idx = wg_linear / wg_per_matrix;
+    let total_batches = params.bs02 * params.broadcast2 * params.bs03 * params.broadcast3;
+    if (batch_idx >= total_batches) {
+        return;
+    }
+    let row = (wg_linear % wg_per_matrix) * ROWS + t / LANES;
+    let live = row < params.m;
+    let dst3_idx = batch_idx / (params.bs02 * params.broadcast2);
+    let dst2_idx = batch_idx % (params.bs02 * params.broadcast2);
+    let src0_base = params.offset_src0 + (dst3_idx / params.broadcast3) * params.stride_03 + (dst2_idx / params.broadcast2) * params.stride_02;
+    let src1_base = params.offset_src1 + dst3_idx * params.stride_13 + dst2_idx * params.stride_12;
+    let n = params.n;
+
+    var s0 = 0.0;
+#ifdef C1
+    var s1 = 0.0;
+#endif
+#ifdef C2
+    var s2 = 0.0;
+#endif
+#ifdef C3
+    var s3 = 0.0;
+#endif
+#ifdef C4
+    var s4 = 0.0;
+#endif
+#ifdef C5
+    var s5 = 0.0;
+#endif
+#ifdef C6
+    var s6 = 0.0;
+#endif
+#ifdef C7
+    var s7 = 0.0;
+#endif
+
+    for (var k0 = 0u; k0 < params.k; k0 += TK) {
+        // The columns' values at k0..k0+TK into shared memory (zeros past them): the
+        // step's columns only.
+        for (var i = t; i < n * TK4; i += THREADS) {
+            let c = i / TK4;
+            let k = k0 + 4u * (i % TK4);
+            let at = src1_base + c * params.stride_11 + k;
+            let last = arrayLength(&src1) - 1u;
+            var v = vec4<f32>(0.0);
+            if (c < n) { // n <= the compiled columns
+                v = vec4<f32>(select(0.0, src1[min(at, last)], k < params.k),
+                              select(0.0, src1[min(at + 1u, last)], k + 1u < params.k),
+                              select(0.0, src1[min(at + 2u, last)], k + 2u < params.k),
+                              select(0.0, src1[min(at + 3u, last)], k + 3u < params.k));
+            }
+            sx[i] = v;
+        }
+        workgroupBarrier();
+
+        if (live) {
+#ifndef SRC0_F16
+            let kb0 = k0 / 32u;
+            let blocks = min(TK / 32u, params.k / 32u - kb0);
+            for (var b = lane; b < blocks; b += LANES) {
+                let at = (src0_base + row * params.stride_01 + kb0 + b) * BLOCK_BYTES;
+                let d = unpack2x16float(load_u32_src0(at) & 0xFFFFu).x;
+                var u0 = 0.0;
+#ifdef C1
+                var u1 = 0.0;
+#endif
+#ifdef C2
+                var u2 = 0.0;
+#endif
+#ifdef C3
+                var u3 = 0.0;
+#endif
+#ifdef C4
+                var u4 = 0.0;
+#endif
+#ifdef C5
+                var u5 = 0.0;
+#endif
+#ifdef C6
+                var u6 = 0.0;
+#endif
+#ifdef C7
+                var u7 = 0.0;
+#endif
+                for (var i = 0u; i < 8u; i++) {
+                    let wv = block_weights(at, i);
+                    let x = b * 8u + i;
+                    u0 += dot(wv, sx[0u * TK4 + x]);
+#ifdef C1
+                    u1 += dot(wv, sx[1u * TK4 + x]);
+#endif
+#ifdef C2
+                    u2 += dot(wv, sx[2u * TK4 + x]);
+#endif
+#ifdef C3
+                    u3 += dot(wv, sx[3u * TK4 + x]);
+#endif
+#ifdef C4
+                    u4 += dot(wv, sx[4u * TK4 + x]);
+#endif
+#ifdef C5
+                    u5 += dot(wv, sx[5u * TK4 + x]);
+#endif
+#ifdef C6
+                    u6 += dot(wv, sx[6u * TK4 + x]);
+#endif
+#ifdef C7
+                    u7 += dot(wv, sx[7u * TK4 + x]);
+#endif
+                }
+                s0 += u0 * d;
+#ifdef C1
+                s1 += u1 * d;
+#endif
+#ifdef C2
+                s2 += u2 * d;
+#endif
+#ifdef C3
+                s3 += u3 * d;
+#endif
+#ifdef C4
+                s4 += u4 * d;
+#endif
+#ifdef C5
+                s5 += u5 * d;
+#endif
+#ifdef C6
+                s6 += u6 * d;
+#endif
+#ifdef C7
+                s7 += u7 * d;
+#endif
+            }
+#else
+            let groups = min(TK4, (params.k - k0) / 4u);
+            let at = src0_base + row * params.stride_01 + k0;
+            for (var g = lane; g < groups; g += LANES) {
+                let a = at + 4u * g;
+                let wv = vec4<f32>(f32(src0[a]), f32(src0[a + 1u]), f32(src0[a + 2u]), f32(src0[a + 3u]));
+                s0 += dot(wv, sx[0u * TK4 + g]);
+#ifdef C1
+                s1 += dot(wv, sx[1u * TK4 + g]);
+#endif
+#ifdef C2
+                s2 += dot(wv, sx[2u * TK4 + g]);
+#endif
+#ifdef C3
+                s3 += dot(wv, sx[3u * TK4 + g]);
+#endif
+#ifdef C4
+                s4 += dot(wv, sx[4u * TK4 + g]);
+#endif
+#ifdef C5
+                s5 += dot(wv, sx[5u * TK4 + g]);
+#endif
+#ifdef C6
+                s6 += dot(wv, sx[6u * TK4 + g]);
+#endif
+#ifdef C7
+                s7 += dot(wv, sx[7u * TK4 + g]);
+#endif
+            }
+#endif
+        }
+        workgroupBarrier();
+    }
+
+    partial[t * 8u + 0u] = s0;
+#ifdef C1
+    partial[t * 8u + 1u] = s1;
+#endif
+#ifdef C2
+    partial[t * 8u + 2u] = s2;
+#endif
+#ifdef C3
+    partial[t * 8u + 3u] = s3;
+#endif
+#ifdef C4
+    partial[t * 8u + 4u] = s4;
+#endif
+#ifdef C5
+    partial[t * 8u + 5u] = s5;
+#endif
+#ifdef C6
+    partial[t * 8u + 6u] = s6;
+#endif
+#ifdef C7
+    partial[t * 8u + 7u] = s7;
+#endif
+    workgroupBarrier();
+
+    // The row's first thread adds its four threads' sums and writes them.
+    if (live && lane == 0u) {
+        let dst_base = params.offset_dst + dst3_idx * (params.m * params.n * params.bs02 * params.broadcast2) + dst2_idx * (params.m * params.n) + row;
+        if (0u < n) { dst[dst_base + 0u * params.m] = partial[t * 8u + 0u] + partial[(t + 1u) * 8u + 0u] + partial[(t + 2u) * 8u + 0u] + partial[(t + 3u) * 8u + 0u]; }
+#ifdef C1
+        if (1u < n) { dst[dst_base + 1u * params.m] = partial[t * 8u + 1u] + partial[(t + 1u) * 8u + 1u] + partial[(t + 2u) * 8u + 1u] + partial[(t + 3u) * 8u + 1u]; }
+#endif
+#ifdef C2
+        if (2u < n) { dst[dst_base + 2u * params.m] = partial[t * 8u + 2u] + partial[(t + 1u) * 8u + 2u] + partial[(t + 2u) * 8u + 2u] + partial[(t + 3u) * 8u + 2u]; }
+#endif
+#ifdef C3
+        if (3u < n) { dst[dst_base + 3u * params.m] = partial[t * 8u + 3u] + partial[(t + 1u) * 8u + 3u] + partial[(t + 2u) * 8u + 3u] + partial[(t + 3u) * 8u + 3u]; }
+#endif
+#ifdef C4
+        if (4u < n) { dst[dst_base + 4u * params.m] = partial[t * 8u + 4u] + partial[(t + 1u) * 8u + 4u] + partial[(t + 2u) * 8u + 4u] + partial[(t + 3u) * 8u + 4u]; }
+#endif
+#ifdef C5
+        if (5u < n) { dst[dst_base + 5u * params.m] = partial[t * 8u + 5u] + partial[(t + 1u) * 8u + 5u] + partial[(t + 2u) * 8u + 5u] + partial[(t + 3u) * 8u + 5u]; }
+#endif
+#ifdef C6
+        if (6u < n) { dst[dst_base + 6u * params.m] = partial[t * 8u + 6u] + partial[(t + 1u) * 8u + 6u] + partial[(t + 2u) * 8u + 6u] + partial[(t + 3u) * 8u + 6u]; }
+#endif
+#ifdef C7
+        if (7u < n) { dst[dst_base + 7u * params.m] = partial[t * 8u + 7u] + partial[(t + 1u) * 8u + 7u] + partial[(t + 2u) * 8u + 7u] + partial[(t + 3u) * 8u + 7u]; }
+#endif
+    }
+}

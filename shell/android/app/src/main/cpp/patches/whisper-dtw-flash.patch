+
+int whisper_full_ivrit_sequence(struct whisper_context * ctx, const whisper_token_data ** tokens) {
+    *tokens = ctx->state->ivrit_sequence.data();
+    return (int) ctx->state->ivrit_sequence.size();
+}
+
+float whisper_full_ivrit_no_speech_prob(struct whisper_context * ctx) {
+    return ctx->state->no_speech_prob;
+}
+
+int whisper_full_ivrit_dtw(struct whisper_context * ctx, const whisper_token * tokens, int n_tokens,
+                           int seek, int n_frames, int64_t * t_dtw, int n_threads) {
+    whisper_state * state = ctx->state;
+    if (!ctx->params.dtw_token_timestamps || n_tokens <= 0 || n_frames <= 0) {
+        return -1;
+    }
+    // The tokens as one segment (and one more, which the DTW's walk may step into).
+    std::vector<whisper_segment> kept;
+    kept.swap(state->result_all);
+    whisper_segment segment{};
+    for (int i = 0; i < n_tokens; ++i) {
+        whisper_token_data d{};
+        d.id = tokens[i];
+        d.t_dtw = -1;
+        segment.tokens.push_back(d);
+    }
+    state->result_all.push_back(segment);
+    whisper_segment pad{};
+    pad.tokens.push_back(whisper_token_data{});
+    state->result_all.push_back(pad);
+    whisper_full_params params = whisper_full_default_params(WHISPER_SAMPLING_GREEDY);
+    params.language = whisper_lang_str(state->lang_id);
+    whisper_exp_compute_token_level_timestamps_dtw(ctx, state, params, 0, 1, seek, n_frames, 7, n_threads);
+    for (int i = 0; i < n_tokens; ++i) {
+        t_dtw[i] = state->result_all[0].tokens[i].t_dtw;
+    }
+    state->result_all.swap(kept);
+    return 0;
+}
+
+int64_t whisper_full_get_segment_seek(struct whisper_context * ctx, int i_segment) {
+    return ctx->state->result_all[i_segment].seek;
+}

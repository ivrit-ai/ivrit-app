// The iPhone app's build settings that are not secrets (see docs/ios.md).
// Signing keys never go here: CI signs with an App Store Connect API key.

// The Apple Developer team (App Store Connect → Membership).
IVRIT_TEAM_ID = WN9KK8S9P8
DEVELOPMENT_TEAM = $(IVRIT_TEAM_ID)

// Google sign-in: the app's iOS OAuth client (Google Cloud → Credentials), and
// the same id reversed, which Google's sign-in returns to (no plist needed).
GOOGLE_IOS_CLIENT_ID = 1075237904697-p6i8c54g4l5mcea9k6c8pu32f5fkn8g4.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1075237904697-p6i8c54g4l5mcea9k6c8pu32f5fkn8g4

// Signing: Xcode's automatic signing for development; scripts/build-ios.sh
// testflight signs manually for the App Store, with profiles that
// scripts/ios-signing.py makes (IVRIT_PROFILE_*), and production push.
IVRIT_SIGN_STYLE = Automatic
IVRIT_SIGN_IDENTITY = Apple Development
IVRIT_APS_ENVIRONMENT = development
IVRIT_PROFILE_APP =
IVRIT_PROFILE_NOTIFICATION_SERVICE =
IVRIT_PROFILE_SHARE_EXTENSION =

// shared/app.json's version, and a build number that only grows; CI sets both
// (scripts/build-ios.sh), as scripts/build-android.sh does for Android.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
